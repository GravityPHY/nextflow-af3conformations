// Nextflow configuration for AF3 conformations pipeline on SGE HPC

// Run all process scripts as login shells so 'module' and 'conda' are available
process.shell = ['/bin/bash', '-l']

profiles {

    sge {
        process.executor = 'sge'

        withName: 'GENERATE_MSA' {
            // MSA generation is CPU-only; runs on general queue
            clusterOptions = '-P docking -l h_rt=04:00:00 -j y -m ea'
            cpus   = 8
            memory = '16 GB'
        }

        withName: 'RUN_AF3' {
            // AF3 inference requires a GPU
            clusterOptions = '-P docking -q iris-gpu -l h_rt=48:00:00 -l gpus=1 -l gpu_c=6.0 -j y -m ea'
            cpus   = 4
            memory = '32 GB'
        }
    }

    // Lightweight local profile for syntax/logic testing (no SGE submission)
    local {
        process.executor = 'local'
    }
}

// Store intermediate files in work/ and cache for -resume
workDir = 'work'

// Trace and timeline reports (written to results/)
trace {
    enabled   = true
    file      = "results/pipeline_trace.txt"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "results/pipeline_timeline.html"
    overwrite = true
}
